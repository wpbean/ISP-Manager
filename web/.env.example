# API base URL. Leave empty in dev (Vite proxies /api to localhost:4000).
VITE_API_URL=

# OLT panel page for ONU optical info. {ponId} and {onuId} are filled from the customer.
VITE_OLT_OPTICAL_URL=https://103.158.118.72:49152/action/onuoptical.html?ponid={ponId}&onuid={onuId}&select=1

# RADIUS panel page for a customer. {radiusId} is filled from the customer's RADIUS ID.
VITE_RADIUS_CLIENT_URL=https://radius.yetfix.com/admin/clients/{radiusId}

# Map basemap tiles (optional). Defaults to OpenStreetMap standard tiles. Leaflet URL template + attribution HTML.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
